{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "关键词方向卡数据契约 V1（模型只产本 JSON，HTML 由 render_keyword_direction.js 出）",
  "type": "object",
  "required": ["title", "period_label", "oneline", "bignums", "fineprint", "lights", "s1_desc", "decisions", "s2_desc", "families", "negatives", "findings_title", "findings", "confirm", "glossary", "window_line", "attach_line"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "description": "客户名 + 搜索广告关键词方向" },
    "period_label": { "type": "string", "description": "本期周期，日期写法，如 2026 年 8 月 31 日至 9 月 13 日期" },
    "oneline": { "type": "string", "maxLength": 60, "description": "一句话方向，sales 可照念" },
    "bignums": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "required": ["k", "v", "s"], "properties": { "k": { "type": "string" }, "v": { "type": "string" }, "unit": { "type": "string" }, "s": { "type": "string", "description": "数字下方一行，说清这意味着什么" } } } },
    "fineprint": { "type": "array", "items": { "type": "string" }, "description": "口径说明段落，允许 <b>；第一段讲询价只算什么，第二段讲电话等观察项" },
    "lights": { "type": "array", "maxItems": 8, "items": { "type": "object", "required": ["name", "state_label", "cls"], "properties": { "name": { "type": "string", "description": "词族人话名" }, "state_label": { "type": "string" }, "cls": { "enum": ["g", "h", "a"], "description": "g 加大 h 保持 a 收缩" } } } },
    "s1_desc": { "type": "string", "description": "第一节引言：几件事、默认做法、截止日期" },
    "decisions": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "object", "required": ["q", "situation", "recommendation", "no_reply", "item", "textarea_hint"], "properties": { "q": { "type": "string" }, "situation": { "type": "string" }, "recommendation": { "type": "string" }, "no_reply": { "type": "string" }, "item": { "type": "string", "pattern": "^[a-z0-9_]{1,60}$", "description": "card_feedback 的 item 标识" }, "textarea_hint": { "type": "string" }, "picks": { "type": "object", "required": ["ph", "save_item", "entries"], "properties": { "ph": { "type": "string" }, "save_item": { "type": "string", "pattern": "^[a-z0-9_]{1,60}$" }, "entries": { "type": "array", "items": { "type": "object", "required": ["kw", "label", "note"], "properties": { "kw": { "type": "string", "description": "机器用词面" }, "label": { "type": "string", "description": "展示词面" }, "note": { "type": "string" } } } } } } } } },
    "s2_desc": { "type": "string" },
    "families": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object", "required": ["name", "cls", "state_label", "spent", "got", "next", "evidence"], "properties": { "name": { "type": "string" }, "cls": { "enum": ["g", "h", "a"] }, "state_label": { "type": "string" }, "spent": { "type": "string" }, "got": { "type": "string" }, "next": { "type": "string" }, "evidence": { "type": "string", "description": "折叠层：窗口、点击数、对照、现测日期" } } } },
    "negatives": { "type": "array", "items": { "type": "string" }, "description": "否词与止血段落，允许 <b>" },
    "findings_title": { "type": "string", "description": "如 三条新发现" },
    "findings": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
    "confirm": { "type": "array", "items": { "type": "string" }, "description": "上期确认记录段落；首版写首版无上期结论" },
    "glossary": { "type": "array", "maxItems": 6, "items": { "type": "object", "required": ["term", "def"], "properties": { "term": { "type": "string" }, "def": { "type": "string" } } } },
    "window_line": { "type": "string", "description": "页脚数据窗口一行" },
    "attach_line": { "type": "string", "description": "页脚随附文件一行，无附件写 随附文件：无" }
  }
}
