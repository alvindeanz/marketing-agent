{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "素材方向卡数据契约 V2（与词卡同构槽位，模型只产本 JSON，HTML 由 render_creative_direction.js 出；窗口日期由渲染器生成）",
  "type": "object",
  "required": [
    "title",
    "oneline",
    "bignums",
    "scope_line",
    "fineprint",
    "s1_desc",
    "decisions",
    "s2_desc",
    "families",
    "negatives",
    "confirm",
    "glossary",
    "attach_line",
    "issued",
    "window"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "description": "客户名 + 搜索广告关键词方向"
    },
    "oneline": {
      "type": "string",
      "maxLength": 60,
      "description": "一句话素材方向，sales 可照念"
    },
    "bignums": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "k",
          "v",
          "s"
        ],
        "properties": {
          "k": {
            "type": "string"
          },
          "v": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "s": {
            "type": "string",
            "description": "数字下方一行；第二个大数字是最能带询价的那条广告，s 里放它的标题原文"
          }
        }
      }
    },
    "fineprint": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "口径与共同归因的完整说明段落（折叠层，scope_line 是它的一行摘要），允许 <b>"
    },
    "s1_desc": {
      "type": "string",
      "description": "第一节引言：几件事、默认做法、截止日期"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "q",
          "situation",
          "recommendation",
          "no_reply",
          "item",
          "textarea_hint"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "situation": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "no_reply": {
            "type": "string"
          },
          "item": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,60}$",
            "description": "card_feedback 的 item 标识"
          },
          "textarea_hint": {
            "type": "string"
          },
          "picks": {
            "type": "object",
            "required": [
              "ph",
              "save_item",
              "entries"
            ],
            "properties": {
              "ph": {
                "type": "string"
              },
              "save_item": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,60}$"
              },
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kw",
                    "label",
                    "note"
                  ],
                  "properties": {
                    "kw": {
                      "type": "string",
                      "description": "机器用词面"
                    },
                    "label": {
                      "type": "string",
                      "description": "展示词面"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "description": "决策卡三类：新文案措辞逐条确认（文案全文进卡）、零曝光素材清理勾选名单（picks，默认清）、pin 测试方案"
    },
    "s2_desc": {
      "type": "string"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "cls",
          "state_label",
          "spent",
          "got",
          "next",
          "evidence",
          "name",
          "brief"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "广告的人话名：ad group 英文名加「的广告」，多条时带一二编号"
          },
          "cls": {
            "enum": [
              "g",
              "h",
              "a"
            ]
          },
          "state_label": {
            "type": "string"
          },
          "spent": {
            "type": "string"
          },
          "got": {
            "type": "string"
          },
          "next": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "description": "折叠层：窗口、点击数、对照、现测日期"
          },
          "brief": {
            "type": "string",
            "maxLength": 60,
            "description": "席位表折叠态的一句话理由，60 字内"
          }
        }
      },
      "description": "每条在投广告一张小卡：花了多少/换来什么/接下来怎么做，依据折叠"
    },
    "negatives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "素材清理段落：零曝光素材汇总、清理原因、每月影响，允许 <b>"
    },
    "confirm": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "上期确认记录段落；首版写首版无上期结论"
    },
    "glossary": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "term",
          "def"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "def": {
            "type": "string"
          }
        }
      },
      "description": "本卡概念一句话解释；Ad Strength 类评级不出现（立场 2）"
    },
    "attach_line": {
      "type": "string",
      "description": "页脚随附文件一行，无附件写 随附文件：无"
    },
    "scope_line": {
      "type": "string",
      "maxLength": 80,
      "description": "第一屏口径一行：询价只算什么，一句话；详情进 fineprint 折叠层"
    },
    "issued": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "发卡月 YYYY-MM。数据窗口 = 发卡月往前两个完整自然月，渲染器按此校验 window"
    },
    "window": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "窗口首日。规则值 = 发卡月前推两个月的 1 日；账户投放不足两个月才许晚于规则日，且必须写 exception_note"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "窗口末日，必须是发卡月上一个自然月的最后一天，无例外"
        },
        "exception_note": {
          "type": "string",
          "description": "窗口不足两个整月的原因一句话（如 账户 7 月 12 日才开始投放，按实际天数计），进页脚窗口行"
        },
        "note": {
          "type": "string",
          "description": "窗口补充说明（覆盖率、剔除区间、现拉日期一类），进页脚窗口行"
        }
      },
      "description": "数据窗口，机器可读。period_label 与 window_line 两个页脚槽由渲染器从本对象生成，数据 JSON 里出现那两个键会被渲染器拒绝"
    },
    "period_note": {
      "type": "string",
      "description": "追加在周期行日期后的半句（如 首版，无上期结论），可省略"
    }
  }
}